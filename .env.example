# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# JWT_SECRET: Secret key for signing admin tokens
JWT_SECRET="angies-salon-dha-karachi-super-secret-2026"

# MONGODB_URI: Optional MongoDB Atlas connection string for external MongoDB
# (If omitted, the app automatically runs its persistent local file-backed datastore in /data/db.json)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/angies_salon?retryWrites=true&w=majority"
